# ---- 示例报告目录 ----
GOOD_BOY/

# ---- IDE / 编辑器 ----
.vs/
.vscode/
.idea/
*.suo
*.user
*.sln.docstates

# ---- 系统文件 ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- mimocode ----
.mimocode/
